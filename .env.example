# APAAR ONE - Environment Configuration
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
DEMO_MODE=true

# Database Configuration
DATABASE_URL=file:./apaar_one.db

# Authentication / Security
SESSION_SECRET=apaar_one_secure_session_secret_for_sih_demo_mode_only
HMAC_SECRET_KEY=apaar_one_pseudonymization_hmac_secret_key_2026

# APAAR / Identity Provider Mode (MOCK | AUTHORIZED)
APAAR_PROVIDER_MODE=MOCK
APAAR_PROVIDER_ENDPOINT=https://sandbox.apisetu.gov.in/abc/v1

# Notifications (MOCK | SMTP)
NOTIFICATION_PROVIDER=MOCK

# Observability
LOG_LEVEL=info

